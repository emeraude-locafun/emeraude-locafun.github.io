---
interface Props {
	title: string;
	description?: string;
}

const { 
	title, 
	description = "Location de catamarans, kayaks et paddles à Lancieux (35). Émeraude Loca-fun vous accueille plage de Saint-Sieu." 
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<meta name="generator" content={Astro.generator} />
		<meta name="google-site-verification" content="ZE8KTIjhj0LuzNeO9UzORQsAnzsgeVMBrJqMR4zza30" />
		<meta name="msvalidate.01" content="D32384BF19B2AEE18EE19B61B89BEAEE" />
		<!-- Google Fonts : 'Montserrat' pour les titres (côté sportif/nautique) et 'Inter' pour la lecture -->
		<link rel="sitemap" href="/sitemap-index.xml" />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">


		<title>{title}</title>
	</head>
	<body class="font-sans text-gray-800 bg-gray-50 flex flex-col min-h-screen">
		
		<!-- Le contenu de votre page (index.astro) sera injecté ici -->
		<main class="flex-grow">
			<slot />
		</main>

		<!-- Pied de page global -->
<!--<footer class="bg-emerald-950 text-white py-8 border-t border-emerald-800">
			<div class="max-w-7xl mx-auto px-4 text-center">
				<p class="font-heading font-bold text-lg mb-2">Émeraude Loca-fun</p>
				<p class="text-emerald-200 text-sm mb-4"><a target="_blank" href="https://maps.app.goo.gl/NvLCjxuCqW9vGEWF9">📍 Plage de Saint-Sieu, 22770 Lancieux</a></p>
				<div class="text-xs text-gray-400">
					&copy; {new Date().getFullYear()} Emma & Gaëtan. Tous droits réservés.
				</div>
			</div>
		</footer>-->

		<!-- NOUVEAU FOOTER -->
		<footer class="bg-emerald-950 text-emerald-100 pt-16 pb-8 border-t-[6px] border-emerald-500 mt-auto">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-center md:items-start text-center md:text-left">
					
					<!-- Colonne 1 : Le Logo et l'identité -->
					<div class="flex flex-col items-center md:items-start">
						<!-- J'ajoute un fond blanc avec padding et arrondi pour que le texte bleu du logo ressorte bien sur le fond vert très sombre -->
						<div class="bg-white/95 p-0 rounded-2xl shadow-xl mb-0 inline-block hover:scale-105 transition-transform duration-300">
							<img 
								src="/images/logo-footer.svg" 
								alt="Logo Émeraude Loca-fun" 
								class="h-24 w-auto object-contain" 
							/>
						</div>
						<p class="text-emerald-200 text-sm mt-2 max-w-xs">
							Votre spot glisse et sensations dans la baie presque parfaite de Lancieux.
						</p>
					</div>

					<!-- Colonne 2 : Nous trouver -->
					<div class="flex flex-col items-center md:items-start md:pt-4">
						<h4 class="text-white font-bold font-heading text-xl mb-4">Nous trouver</h4>
						
						<p class="text-emerald-200 leading-relaxed text-sm">
							<a target="_blank" href="https://maps.app.goo.gl/NvLCjxuCqW9vGEWF9">Plage de Saint-Sieu 📍<br/> 22770 Lancieux</a></p>
							
						<a href="/#contact" class="mt-4 inline-block text-emerald-400 hover:text-white font-bold text-sm transition-colors">
							→ Voir comment réserver
						</a>
					</div>

					<!-- Colonne 3 : Réseaux Sociaux -->
					<div class="flex flex-col items-center md:items-start md:pt-4">
						<h4 class="text-white font-bold font-heading text-xl mb-4">Suivez-nous</h4>
						<p class="text-emerald-200 text-sm mb-4">
							Partagez vos meilleures sessions avec nous !
						</p>
						<div class="flex space-x-5">
							
							<!-- Lien Instagram -->
							<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-white hover:scale-110 transition-all duration-300" aria-label="Instagram">
								<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
								</svg>
							</a>

							<!-- Lien Facebook -->
							<a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-white hover:scale-110 transition-all duration-300" aria-label="Facebook">
								<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
								</svg>
							</a>

						</div>
					</div>

				</div>

				<!-- Copyright & Mentions -->
				<div class="mt-16 pt-8 border-t border-emerald-900 flex flex-col md:flex-row justify-between items-center text-xs text-emerald-400/80">
					<p>&copy; {new Date().getFullYear()} Emma & Gaëtan - Émeraude Loca-fun. Tous droits réservés.</p>
					<div class="flex space-x-4 mt-4 md:mt-0">
						<p class="hover:text-emerald-200 transition">SIRET. 892 445 099 000XX</p>
					</div>
				</div>
			</div>
		</footer>

		<!-- Script de redirection automatique après login admin -->
		<script>
			declare global {
				interface Window {
					netlifyIdentity: any;
				}
			}
			if (window.netlifyIdentity) {
				window.netlifyIdentity.on("init", (user: any) => {
					if (!user) {
						window.netlifyIdentity.on("login", () => {
							document.location.href = "/admin/";
						});
					}
				});
			}
		</script>
	</body>
</html>

<style is:global>
	/* Définition globale des polices via Tailwind ou CSS standard */
	:root {
		--accent: 16, 185, 129; /* Couleur Emerald-500 */
	}
	html {
		font-family: 'Inter', sans-serif;
		background-color: #f9fafb;
	}
	h1, h2, h3, h4, h5, h6 {
		font-family: 'Montserrat', sans-serif;
	}
</style>